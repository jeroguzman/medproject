# Referencia de nombres. Generar el archivo real con configure-production-env.py.
API_DOMAIN=medvox.tech
# true = demo completa simulada; false = login/pacientes/notas de lectura en API real
FRONTEND_MOCKS=false
AUTH_PROVIDER=mojoauth
MOJOAUTH_API_KEY=
MOJOAUTH_API_SECRET=
# Botones de acceso con Google/Facebook; vacío los oculta. Ver docs/MOJOAUTH.md.
MOJOAUTH_SOCIAL_PROVIDERS=google,facebook
CORS_ALLOWED_ORIGINS=https://medvox.tech
POSTGRES_DB=vozclinica
POSTGRES_USER=vozclinica
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DEMO_PASSWORD=
# Procesamiento de audio: n8n (WF-1, modo normal), django (plan C) o eco (ejemplo fijo).
IA_ORQUESTADOR=n8n
# Modo n8n: URL base sin /webhook y el mismo secreto de la credencial X-VozClinica-Secret.
N8N_BASE_URL=
N8N_SECRET=
# Solo modo django.
ELEVENLABS_API_KEY=
BACKBOARD_API_KEY=
