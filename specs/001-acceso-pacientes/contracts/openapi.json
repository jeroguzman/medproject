{
  "openapi": "3.1.0",
  "info": {
    "title": "MedVox — acceso y pacientes",
    "version": "0.1.0",
    "description": "Diseño de 001, derivado de guía backend §6. Rutas sin slash final, UTF-8, fechas ISO, horas HH:MM y eventos con zona. Métodos para autorizar/corregir pertenecen a 004/005 y no se implementan aquí. 403/no_encontrado y validación de campos internos son precisiones de este diseño, no respuestas ya verificadas."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Iniciar sesión de médico",
        "responses": {
          "200": {
            "description": "Iniciar sesión de médico",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginRespuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos; codigo validacion, con detalles/faltantes cuando aplique.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada; login usa credenciales_invalidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "medicoActual",
        "summary": "Consultar médico autenticado",
        "responses": {
          "200": {
            "description": "Consultar médico autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Medico"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada; login usa credenciales_invalidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Usuario sin perfil médico habilitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/pacientes": {
      "get": {
        "operationId": "listarPacientes",
        "summary": "Lista sin paginación; q busca nombres/apellidos sin acentos ni mayúsculas, expediente o fecha ISO/DD/MM/AAAA",
        "responses": {
          "200": {
            "description": "Lista sin paginación; q busca nombres/apellidos sin acentos ni mayúsculas, expediente o fecha ISO/DD/MM/AAAA",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Paciente"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada; login usa credenciales_invalidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Usuario sin perfil médico habilitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Vacío u omitido lista todos; fecha reconocida filtra nacimiento por igualdad."
          }
        ]
      },
      "post": {
        "operationId": "crearPaciente",
        "summary": "Registrar con expediente asignado por servidor",
        "responses": {
          "201": {
            "description": "Registrar con expediente asignado por servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paciente"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos; codigo validacion, con detalles/faltantes cuando aplique.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada; login usa credenciales_invalidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Usuario sin perfil médico habilitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PacienteEntrada"
              }
            }
          }
        }
      }
    },
    "/api/pacientes/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "obtenerPaciente",
        "summary": "Consultar ficha",
        "responses": {
          "200": {
            "description": "Consultar ficha",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paciente"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada; login usa credenciales_invalidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Usuario sin perfil médico habilitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente; codigo no_encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "editarPaciente",
        "summary": "Editar ficha; mejora S",
        "responses": {
          "200": {
            "description": "Editar ficha; mejora S",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paciente"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos; codigo validacion, con detalles/faltantes cuando aplique.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada; login usa credenciales_invalidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Usuario sin perfil médico habilitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente; codigo no_encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PacienteCambios"
              }
            }
          }
        }
      }
    },
    "/api/pacientes/{id}/notas": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "historialPaciente",
        "summary": "Notas por fecha/hora descendente; una fila por nota y diagnóstico de versión vigente",
        "responses": {
          "200": {
            "description": "Notas por fecha/hora descendente; una fila por nota y diagnóstico de versión vigente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NotaResumen"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada; login usa credenciales_invalidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Usuario sin perfil médico habilitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente; codigo no_encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notas/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "obtenerNota",
        "summary": "Detalle autorizado con todas sus versiones de solo lectura",
        "responses": {
          "200": {
            "description": "Detalle autorizado con todas sus versiones de solo lectura",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotaDetalle"
                }
              }
            }
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada; login usa credenciales_invalidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Usuario sin perfil médico habilitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente; codigo no_encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "codigo": {
                "type": "string"
              },
              "mensaje": {
                "type": "string"
              },
              "faltantes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "detalles": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "codigo",
              "mensaje"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Medico": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "nombre_completo": {
            "type": "string"
          },
          "cedula_profesional": {
            "type": "string"
          },
          "especialidad": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nombre_completo",
          "cedula_profesional",
          "especialidad"
        ]
      },
      "LoginEntrada": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "string",
            "minLength": 1
          },
          "contrasena": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "usuario",
          "contrasena"
        ],
        "additionalProperties": false
      },
      "LoginRespuesta": {
        "type": "object",
        "properties": {
          "access": {
            "type": "string",
            "minLength": 1
          },
          "medico": {
            "$ref": "#/components/schemas/Medico"
          }
        },
        "required": [
          "access",
          "medico"
        ]
      },
      "Paciente": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "numero_expediente": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}$"
          },
          "nombres": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "apellido_paterno": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "apellido_materno": {
            "type": "string",
            "maxLength": 100
          },
          "fecha_nacimiento": {
            "type": "string",
            "format": "date"
          },
          "sexo": {
            "type": "string",
            "enum": [
              "mujer",
              "hombre",
              "no_especificado"
            ]
          },
          "alergias": {
            "type": "string",
            "minLength": 1
          },
          "tipo_sangre": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 3
          },
          "telefono": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          },
          "ultima_consulta": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "total_notas": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "numero_expediente",
          "nombres",
          "apellido_paterno",
          "apellido_materno",
          "fecha_nacimiento",
          "sexo",
          "alergias",
          "tipo_sangre",
          "telefono",
          "ultima_consulta",
          "total_notas"
        ]
      },
      "PacienteEntrada": {
        "type": "object",
        "properties": {
          "nombres": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "apellido_paterno": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "apellido_materno": {
            "type": "string",
            "maxLength": 100
          },
          "fecha_nacimiento": {
            "type": "string",
            "format": "date"
          },
          "sexo": {
            "type": "string",
            "enum": [
              "mujer",
              "hombre",
              "no_especificado"
            ]
          },
          "alergias": {
            "type": "string",
            "minLength": 1
          },
          "telefono": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          }
        },
        "required": [
          "nombres",
          "apellido_paterno",
          "fecha_nacimiento",
          "sexo",
          "alergias"
        ],
        "additionalProperties": false,
        "description": "Recortar textos; fecha no futura; campos internos y expediente no admitidos. Coincidencias son advertencia, no unicidad por identidad."
      },
      "PacienteCambios": {
        "type": "object",
        "properties": {
          "nombres": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "apellido_paterno": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "apellido_materno": {
            "type": "string",
            "maxLength": 100
          },
          "fecha_nacimiento": {
            "type": "string",
            "format": "date"
          },
          "sexo": {
            "type": "string",
            "enum": [
              "mujer",
              "hombre",
              "no_especificado"
            ]
          },
          "alergias": {
            "type": "string",
            "minLength": 1
          },
          "telefono": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          }
        },
        "required": [],
        "additionalProperties": false,
        "minProperties": 1,
        "description": "Mejora S. No admite numero_expediente, creado_por ni contadores."
      },
      "NotaResumen": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "fecha_consulta": {
            "type": "string",
            "format": "date"
          },
          "hora_atencion": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "tipo_consulta": {
            "type": "string",
            "enum": [
              "primera_vez",
              "seguimiento"
            ]
          },
          "diagnostico_principal": {
            "type": [
              "string",
              "null"
            ]
          },
          "estado": {
            "type": "string",
            "enum": [
              "autorizada",
              "corregida"
            ]
          },
          "version_vigente": {
            "type": "integer",
            "minimum": 1
          },
          "medico": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "fecha_consulta",
          "hora_atencion",
          "tipo_consulta",
          "diagnostico_principal",
          "estado",
          "version_vigente",
          "medico"
        ]
      },
      "PlantillaRef": {
        "type": "object",
        "properties": {
          "clave": {
            "const": "formato_clinico_general",
            "type": "string"
          },
          "version": {
            "const": "1.1",
            "type": "string"
          }
        },
        "required": [
          "clave",
          "version"
        ]
      },
      "Segmento": {
        "type": "object",
        "properties": {
          "hablante": {
            "type": "string"
          },
          "rol": {
            "type": "string",
            "enum": [
              "medico",
              "paciente",
              "desconocido"
            ]
          },
          "texto": {
            "type": "string"
          },
          "inicio": {
            "type": "number",
            "minimum": 0
          },
          "fin": {
            "type": "number",
            "minimum": 0
          },
          "audio": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "hablante",
          "texto",
          "inicio",
          "fin"
        ]
      },
      "Transcripcion": {
        "type": "object",
        "properties": {
          "texto": {
            "type": "string"
          },
          "segmentos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Segmento"
            }
          }
        },
        "required": [
          "texto",
          "segmentos"
        ],
        "description": "P-06 provisional: conservar texto; confirmar conservación de segmentos. Nunca audio binario."
      },
      "ContenidoClinico": {
        "type": "object",
        "additionalProperties": true,
        "description": "Objeto de secciones del Formato Clínico General v1.1 según REQUERIMIENTOS §7 y esquema compartido de 003/VC-01. Esta interfaz de lectura no redefine ni acredita validación del esquema clínico completo."
      },
      "VersionNota": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "integer",
            "minimum": 1
          },
          "contenido": {
            "$ref": "#/components/schemas/ContenidoClinico"
          },
          "transcripcion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Transcripcion"
              },
              {
                "type": "null"
              }
            ]
          },
          "autorizada_por": {
            "type": "string"
          },
          "autorizada_en": {
            "type": "string",
            "format": "date-time"
          },
          "motivo_cambio": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "numero",
          "contenido",
          "transcripcion",
          "autorizada_por",
          "autorizada_en",
          "motivo_cambio"
        ],
        "description": "Solo lectura; motivo obligatorio y no vacío desde versión 2. Orden descendente por numero."
      },
      "NotaDetalle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "fecha_consulta": {
            "type": "string",
            "format": "date"
          },
          "hora_atencion": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "tipo_consulta": {
            "type": "string",
            "enum": [
              "primera_vez",
              "seguimiento"
            ]
          },
          "estado": {
            "type": "string",
            "enum": [
              "autorizada",
              "corregida"
            ]
          },
          "version_vigente": {
            "type": "integer",
            "minimum": 1
          },
          "paciente": {
            "$ref": "#/components/schemas/Paciente"
          },
          "medico": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "nombre_completo": {
                "type": "string"
              },
              "cedula_profesional": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "nombre_completo",
              "cedula_profesional"
            ]
          },
          "plantilla": {
            "$ref": "#/components/schemas/PlantillaRef"
          },
          "modo_captura": {
            "type": "string",
            "enum": [
              "dictado",
              "consulta"
            ]
          },
          "consentimiento_grabacion": {
            "type": "boolean"
          },
          "versiones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VersionNota"
            }
          }
        },
        "required": [
          "id",
