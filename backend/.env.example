# Copia a backend/.env y genera secretos locales; no agregues .env a Git.
POSTGRES_DB=vozclinica
POSTGRES_USER=vozclinica
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Completa la contraseña en la URL con el mismo valor de POSTGRES_PASSWORD.
DATABASE_URL=
DJANGO_SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# German comunicará los orígenes exactos para cada entorno.
CORS_ALLOWED_ORIGINS=http://localhost:8080
DEMO_PASSWORD=
# Solo true en un backend sin puerto público detrás de un proxy TLS confiable.
DJANGO_TRUST_PROXY_HEADERS=false

# MojoAuth: nunca exponer estas claves como variables VITE_.
AUTH_PROVIDER=password
MOJOAUTH_API_KEY=
MOJOAUTH_API_SECRET=
# Acceso con Google/Facebook (solo modo mojoauth). La URL debe estar autorizada en MojoAuth.
MOJOAUTH_SOCIAL_PROVIDERS=
MOJOAUTH_REDIRECT_URL=http://localhost:8080/login/social

# IA: eco devuelve el caso de ejemplo sin llamar a servicios externos.
IA_ORQUESTADOR=eco
N8N_BASE_URL=
N8N_SECRET=
ELEVENLABS_API_KEY=
BACKBOARD_API_KEY=
